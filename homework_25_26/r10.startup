/etc/init.d/networking restart

# Routing rules
ip route add default via 151.0.45.0

# NAT and firewall rules
iptables -t nat -A POSTROUTING -s 192.168.88.0/24 -j MASQUERADE
iptables -A FORWARD -i eth0 -o eth1 -m state --state ESTABLISHED,RELATED -j ACCEPT
iptables -A FORWARD -i eth1 -o eth0 -m state --state NEW -j DROP
## Rules for VPN
iptables -t nat -A PREROUTING -p tcp -d 151.0.45.1 --dport 7070 -j DNAT --to-destination 192.168.88.100:7070
iptables -I FORWARD -i eth1 -o eth0 -p tcp -d 192.168.88.100 --dport 7070 -m state --state NEW -j ACCEPT
